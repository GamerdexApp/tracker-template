{
    "name": "tracker-template",
    "version": "2.0.0",
    "description": "A Next.js template for Gamerdex game progress trackers, with playthroughs, cloud sync and 19 languages",
    "keywords": [
        "game-tracker",
        "gamerdex",
        "nextjs",
        "react",
        "tailwindcss",
        "i18n",
        "cloud-sync",
        "template"
    ],
    "author": "",
    "license": "MIT",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "vitest run",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check:i18n": "node scripts/check-i18n.mjs",
        "check:catalogs": "node scripts/check-catalogs.mjs",
        "gen:locales": "node scripts/gen-locale-indexes.mjs"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@gamerdexapp/gamerdex-sync": "0.5.0",
        "nanoid": "^6.0.2",
        "next": "^16.4.3",
        "next-intl": "4.14.9",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.13.0",
        "eslint-config-next": "16.4.3",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-icons": "^5.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
